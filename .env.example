# Copy to .env for local development. Never commit a filled .env or real secrets.
# Production values belong in the Render (or host) environment, not in git.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# HOST=0.0.0.0 is required so the Android emulator can reach the API at http://10.0.2.2:8080.
# HOST=127.0.0.1 would work for curl on the PC but not for the emulator. Production still uses
# the platform HOST (Render: 0.0.0.0) with TLS at the edge — see docs/LOCAL_TESTING.md.

# Comma-separated browser origins. Native Android clients typically send no Origin.
# Production: https origins only; wildcard * is rejected.
CORS_ORIGIN=http://localhost:8080

# Required in production (https). Used for operator logs; Android apps use BuildConfig URLs.
PUBLIC_BASE_URL=
# Optional. Production must be wss:// if set. Defaults to PUBLIC_BASE_URL with http→ws.
PUBLIC_WS_URL=

DATABASE_URL=postgresql://lab:lab_dev_only@localhost:5432/android_remote_lab?schema=public
# Optional operator note: use the Supabase direct (session) URL for `prisma migrate deploy`
# if the runtime URL is a transaction pooler. Prisma schema reads DATABASE_URL only.
DIRECT_URL=

# Secrets must be at least 32 characters. Generate unique values per environment.
# Production rejects placeholders such as replace-with-… or lab_dev_only.
JWT_ACCESS_SECRET=replace-with-32-plus-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-refresh-secret
PAIRING_PEPPER=replace-with-32-plus-char-pairing-pepper

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
DEVICE_ACCESS_TOKEN_TTL_SECONDS=900
DEVICE_REFRESH_TOKEN_TTL_SECONDS=2592000
PAIRING_TTL_SECONDS=600
# Idle timeout for active remote sessions (extended on activity; default 30 days)
SESSION_TIMEOUT_SECONDS=2592000
PRESENCE_OFFLINE_AFTER_SECONDS=45
MAX_DEVICES_PER_ADMIN=50

# Unset in production defaults to false. Local demo defaults to true.
ALLOW_ADMIN_REGISTRATION=true
# Local-only first admin. Omit in production after the first operator exists.
ADMIN_BOOTSTRAP_EMAIL=admin@lab.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_LabOnly_12

STORAGE_PROVIDER=local
STORAGE_DIR=./data/backups
# Demo default: durable backup bytes live on the Admin device after ingest.
BACKUP_PAYLOAD_DESTINATION=LOCAL_ADMIN

# ICE. Override STUN; set TURN only if you operate an external TURN service.
# In NODE_ENV=development with TURN_URLS empty, the API embeds a local TURN on UDP/TCP 3478
# so the Admin emulator (10.0.2.2) and a physical Target on LAN can exchange media.
# Credentials are not logged. Production must set TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
